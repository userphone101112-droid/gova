{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/features/*": ["./src/features/*"],
      "@/services/*": ["./src/services/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/store/*": ["./src/store/*"],
      "@/types/*": ["./src/types/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/configs/*": ["./src/configs/*"],
      "@/server/*": ["./src/server/*"],
      "@gv/theme": ["./packages/theme/index.ts"],
      "@gv/translations": ["./packages/translations/index.ts"],
      "@gv/branding": ["./packages/branding/index.ts"],
      "@gv/localization": ["./packages/localization/index.ts"],
      "@gv/design-system": ["./packages/design-system/index.tsx"],
      "@gv/contracts": ["./packages/contracts/index.ts"],
      "@gv/domain": ["./packages/domain/index.ts"],
      "@gv/schemas": ["./packages/schemas/index.ts"],
      "@gv/auth": ["./packages/auth/index.ts"],
      "@gv/features": ["./packages/features/index.ts"],
      "@gv/storage": ["./packages/storage/index.ts"],
      "@gv/business-rules": ["./packages/business-rules/index.ts"],
      "@gv/config": ["./packages/config/index.ts"],
      "@gv/formatting": ["./packages/formatting/index.ts"],
      "@gv/shared-types": ["./packages/shared-types/index.ts"],
      "@gv/shared": ["./packages/shared/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "apps"]
}
