{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "rootDir": ".",
    "outDir": "./dist",
    "removeComments": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/domain/*": ["./src/domain/*"],
      "@/application/*": ["./src/application/*"],
      "@/infrastructure/*": ["./src/infrastructure/*"],
      "@/interfaces/*": ["./src/interfaces/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/config/*": ["./src/config/*"],
      "@gv/theme": ["../../packages/theme/index.ts"],
      "@gv/translations": ["../../packages/translations/index.ts"],
      "@gv/branding": ["../../packages/branding/index.ts"],
      "@gv/localization": ["../../packages/localization/index.ts"],
      "@gv/design-system": ["../../packages/design-system/index.tsx"],
      "@gv/contracts": ["../../packages/contracts/index.ts"],
      "@gv/domain": ["../../packages/domain/index.ts"],
      "@gv/schemas": ["../../packages/schemas/index.ts"],
      "@gv/auth": ["../../packages/auth/index.ts"],
      "@gv/features": ["../../packages/features/index.ts"],
      "@gv/storage": ["../../packages/storage/index.ts"],
      "@gv/business-rules": ["../../packages/business-rules/index.ts"],
      "@gv/config": ["../../packages/config/index.ts"],
      "@gv/formatting": ["../../packages/formatting/index.ts"],
      "@gv/shared-types": ["../../packages/shared-types/index.ts"],
      "@gv/shared": ["../../packages/shared/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
